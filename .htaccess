<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # Attempt to serve backend uploads directly to bypass Python workers
  RewriteCond %{REQUEST_URI} ^/uploads/(.*) [NC]
  RewriteCond %{DOCUMENT_ROOT}/public/uploads/%1 -f
  RewriteRule ^uploads/(.*)$ public/uploads/$1 [L]

  # Attempt to serve frontend assets and HTML directly
  RewriteCond %{REQUEST_URI} ^/(assets|.*\.html) [NC]
  RewriteCond %{DOCUMENT_ROOT}/backend/app/static/$1 -f
  RewriteRule ^(.*)$ backend/app/static/$1 [L]
</IfModule>

# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/alpheojj/Real-Estate-CRM"
PassengerBaseURI "/"
PassengerPython "/home/alpheojj/virtualenv/Real-Estate-CRM/3.13/bin/python"
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

<IfModule Litespeed>
  SetEnv LSAPI_CHILDREN 20
</IfModule>
