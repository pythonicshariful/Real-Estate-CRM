# ---------------------------------------------------------
# Southeast Landmark CRM - Environment Configuration
# ---------------------------------------------------------
# Rename this file to .env and place it in the same directory as wsgi.py

# ==========================================
# 0. SCHEDULER SETTINGS (OPTIONAL)
# ==========================================
# Set to True in cPanel to prevent Passenger from running background threads.
# You MUST set up a manual cron job to run backend/cron.py if you disable this!
DISABLE_SCHEDULER=False

# ==========================================
# 1. CORE SETTINGS (REQUIRED)
# ==========================================
FLASK_CONFIG=production
SECRET_KEY=change-this-to-a-random-64-char-string
JWT_SECRET_KEY=change-this-to-another-random-64-char-string
DEBUG=False

# ==========================================
# 2. DATABASE (REQUIRED)
# ==========================================
# For cPanel/PythonAnywhere, use your actual MySQL credentials.
# Format: mysql+pymysql://<user>:<password>@<host>/<dbname>
DATABASE_URL=mysql+pymysql://crm_user:strongpassword@localhost/crm_southeast

# ==========================================
# 3. MEGA.NZ INTEGRATION (REQUIRED FOR RECORDINGS)
# ==========================================
MEGA_EMAIL=your_mega_account@email.com
MEGA_PASSWORD=your_mega_password

# ==========================================
# 4. EMAIL / SMTP (REQUIRED FOR NOTIFICATIONS)
# ==========================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=CRM System <your-email@gmail.com>

# ==========================================
# 5. META LEAD ADS WEBHOOK (OPTIONAL)
# ==========================================
# Required if you want to automatically receive leads from Facebook/Instagram Ads
META_VERIFY_TOKEN=your-webhook-verify-token
META_PAGE_ACCESS_TOKEN=your-page-access-token
META_APP_SECRET=your-app-secret
META_APP_ID=your-app-id

# ==========================================
# 6. SECURITY & SLA (OPTIONAL - HAS DEFAULTS)
# ==========================================
SESSION_TIMEOUT_MINUTES=60
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30

SLA_NOTIFY_MINUTES=0
SLA_REMINDER_MINUTES=10
SLA_MANAGER_ALERT_MINUTES=20
SLA_ESCALATE_MINUTES=30
