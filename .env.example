# Flask
FLASK_ENV=production
SECRET_KEY=change-this-to-a-random-64-char-string
JWT_SECRET_KEY=change-this-to-another-random-64-char-string
DEBUG=False

# Database  
DATABASE_URL=postgresql://crm_user:strongpassword@db:5432/crm_southeast
POSTGRES_DB=crm_southeast
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=strongpassword

# Redis
REDIS_URL=redis://:redispassword@redis:6379/0
REDIS_PASSWORD=redispassword

# Celery
CELERY_BROKER_URL=redis://:redispassword@redis:6379/0
CELERY_RESULT_BACKEND=redis://:redispassword@redis:6379/1

# MinIO (Call Recordings)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET_RECORDING=recordings
MINIO_BUCKET_BACKUP=backups
MINIO_USE_SSL=False

# Email (SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=CRM System <your-email@gmail.com>

# Meta Lead Ads (Webhook)
META_VERIFY_TOKEN=your-webhook-verify-token
META_PAGE_ACCESS_TOKEN=your-page-access-token
META_APP_SECRET=your-app-secret
META_APP_ID=your-app-id

# SLA Settings (minutes)
SLA_NOTIFY_MINUTES=0
SLA_REMINDER_MINUTES=10
SLA_MANAGER_ALERT_MINUTES=20
SLA_ESCALATE_MINUTES=30

# Security
SESSION_TIMEOUT_MINUTES=60
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30
