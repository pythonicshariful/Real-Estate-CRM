# ============================================================
# Southeast Landmark CRM — Environment Variables
# Copy this to .env and fill in your real values
# NEVER commit .env to Git — keep it private!
# ============================================================

# Flask
FLASK_CONFIG=production
SECRET_KEY=replace-with-64-random-characters-use-password-generator
JWT_SECRET_KEY=replace-with-another-64-random-characters-different-from-above

# ── Database ────────────────────────────────────────────────
# MySQL (cPanel / PythonAnywhere) — most common
DATABASE_URL=mysql+pymysql://DB_USERNAME:DB_PASSWORD@localhost/DB_NAME

# PostgreSQL (if your host supports it)
# DATABASE_URL=postgresql://DB_USERNAME:DB_PASSWORD@localhost/DB_NAME

# SQLite for local testing on your own PC only:
# DATABASE_URL=sqlite:///crm_dev.db

# ── Email (SMTP) ────────────────────────────────────────────
# For Gmail: use an App Password (not your real password)
# Google Account → Security → 2-Step Verification → App passwords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password-16-chars
MAIL_DEFAULT_SENDER=Southeast Landmark CRM <your-email@gmail.com>

# ── Meta Lead Ads Webhook ───────────────────────────────────
# See META_WEBHOOK_SETUP.md for how to get these values
META_VERIFY_TOKEN=choose-any-random-string-eg-sl-webhook-2024
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=
META_APP_ID=

# ── SLA Timer Settings (in minutes) ────────────────────────
SLA_NOTIFY_MINUTES=0
SLA_REMINDER_MINUTES=10
SLA_MANAGER_ALERT_MINUTES=20
SLA_ESCALATE_MINUTES=30

# ── File Upload ─────────────────────────────────────────────
# Absolute path to where recordings are stored
# cPanel example:    /home/yourusername/crmforsouth/uploads
# PythonAnywhere:    /home/yourusername/crmforsouth/uploads
UPLOAD_FOLDER=uploads
RECORDINGS_FOLDER=uploads/recordings

# ── Security ────────────────────────────────────────────────
RECORDING_LINK_EXPIRY_SECONDS=900
